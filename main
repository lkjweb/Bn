
-- Blox Note Multi-Hack Script (Safe Mobile & Delta Executor Build)
-- EN ids, RU comments, без TODO

local OrionLib = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Window = OrionLib:MakeWindow({Name = "Blox Note Hub", HidePremium = false, SaveConfig = false})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

-- Глобальные настройки софта
_G.ESPEnabled = false
_G.AimbotEnabled = false
_G.AimbotFOV = 120
_G.SelfChamsEnabled = false

-- Функция удаления меток при отключении ESP
local function clearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local oldESP = p.Character.Head:FindFirstChild("RoleESP")
            if oldESP then oldESP:Destroy() end
        end
    end
end

-- Функция создания красивого текстового ESP над головой
local function createESP(player, text, color)
    if not _G.ESPEnabled or player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    
    local head = character:WaitForChild("Head", 2)
    local root = character:WaitForChild("HumanoidRootPart", 2)
    if not head or not root then return end
    
    local billboard = head:FindFirstChild("RoleESP")
    local label
    
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "RoleESP"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.Parent = head

        label = Instance.new("TextLabel")
        label.Name = "ESPLabel"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0
        label.Parent = billboard
    else
        label = billboard:FindFirstChild("ESPLabel")
    end

    if label and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
        label.Text = string.format("%s\n%s\n[%d m]", text, player.Name, distance)
        label.TextColor3 = color
    end
end

-- Точное сканирование ролей в режиме Blox Note
local function getPlayerRole(p)
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    
    -- Проверка на Киру
    local isKira = false
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if string.find(string.lower(item.Name), "death") or string.find(string.lower(item.Name), "note") or string.find(string.lower(item.Name), "kira") then
                if not string.find(string.lower(item.Name), "second") and not string.find(string.lower(item.Name), "2") and not string.find(string.lower(item.Name), "l") then
                    isKira = true
                end
            end
        end
    end
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (string.find(string.lower(item.Name), "death") or string.find(string.lower(item.Name), "note")) then
                if not string.find(string.lower(item.Name), "second") and not string.find(string.lower(item.Name), "2") and not string.find(string.lower(item.Name), "l") then
                    isKira = true
                end
            end
        end
    end
    if isKira or p:GetAttribute("Role") == "Kira" or p:GetAttribute("Kira") == true then return "KIRA" end

    -- Проверка на Помощника
    local isAssistant = false

if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if string.find(string.lower(item.Name), "second") or string.find(string.lower(item.Name), "assistant") or string.find(string.lower(item.Name), "note2") then
                isAssistant = true
            end
        end
    end
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (string.find(string.lower(item.Name), "second") or string.find(string.lower(item.Name), "assistant") or string.find(string.lower(item.Name), "note2")) then
                isAssistant = true
            end
        end
    end
    if isAssistant or p:GetAttribute("Role") == "Assistant" or p:GetAttribute("SecondKira") == true then return "ASSISTANT" end
    
    -- Проверка на L
    if p:FindFirstChild("IsL") or p:GetAttribute("Role") == "L" or p:GetAttribute("L") == true then return "L" end
    if backpack and (backpack:FindFirstChild("L Notebook") or backpack:FindFirstChild("Badge")) then return "L" end
    
    return "INVESTIGATOR"
end

-- Мобильный Аимбот (плавная доводка камеры на Киру по центру экрана)
local function getClosestKiraToCenter()
    local closestPlayer = nil
    local shortestDistance = _G.AimbotFOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local role = getPlayerRole(p)
            if role == "KIRA" or role == "ASSISTANT" then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        closestPlayer = p
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Чамсы (Подсветка персонажа)
local function updateSelfChams()
    local char = LocalPlayer.Character
    if not char then return end
    local chams = char:FindFirstChild("SelfChams")
    if _G.SelfChamsEnabled then
        if not chams then
            chams = Instance.new("Highlight")
            chams.Name = "SelfChams"
            chams.FillColor = Color3.fromRGB(0, 255, 255)
            chams.FillTransparency = 0.5
            chams.OutlineColor = Color3.fromRGB(255, 255, 255)
            chams.OutlineTransparency = 0
            chams.Parent = char
        end
    else
        if chams then chams:Destroy() end
    end
end

-- Логика переключения интерфейса кнопкой MENU
local function toggleMenu()
    local orionGui = CoreGui:FindFirstChild("Orion")
    if orionGui then
        for _, frame in ipairs(orionGui:GetChildren()) do
            if frame:IsA("Frame") or frame:IsA("ScreenGui") then
                frame.Enabled = not frame.Enabled
            elseif frame:IsA("GuiObject") then
                frame.Visible = not frame.Visible
            end
        end
    end
end

-- Создание плавающей мобильной кнопки MENU
local function createToggleButton()
    local existingGui = CoreGui:FindFirstChild("OrionToggleGui")
    if existingGui then existingGui:Destroy() end

    local screenGui = Instance.new("ScreenGui", CoreGui)
    screenGui.Name = "OrionToggleGui"
    screenGui.ResetOnSpawn = false

    local button = Instance.new("TextButton", screenGui)
    button.Size = UDim2.new(0, 60, 0, 60)
    button.Position = UDim2.new(0, 10, 0, 150)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    button.Text = "MENU"
    button.TextColor3 = Color3.fromRGB(255, 0, 0)
    button.TextSize = 14
    button.Font = Enum.Font.SourceSansBold

    local uiCorner = Instance.new("UICorner", button)
    uiCorner.CornerRadius = UDim.new(0, 30)

    local uiStroke = Instance.new("UIStroke", button)
    uiStroke.Color = Color3.fromRGB(255, 0, 0)
    uiStroke.Thickness = 2

button.MouseButton1Click:Connect(toggleMenu)
end

createToggleButton()

-- Основной цикл обновлений аимбота и чамсов
RunService.RenderStepped:Connect(function()
    if _G.AimbotEnabled then
        local target = getClosestKiraToCenter()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
        end
    end
    updateSelfChams()
end)

-- Постоянный цикл обновления ролей для ESP
task.spawn(function()
    while true do
        if _G.ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getPlayerRole(p)
                    if role == "KIRA" then
                        createESP(p, "[ KIRA ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "ASSISTANT" then
                        createESP(p, "[ KIRA ASSISTANT ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "L" then
                        createESP(p, "[ L ]", Color3.fromRGB(0, 100, 255))
                    else
                        createESP(p, "[ INVESTIGATOR ]", Color3.fromRGB(0, 255, 0))
                    end
                end
            end
        else
            clearESP()
        end
        task.wait(0.2)
    end
end)

-- Меню Orion
local MainTab = Window:MakeTab({Name = "Main", Icon = "rbxassetid://4483345998", PremiumOnly = false})
local FunTab = Window:MakeTab({Name = "Fun", Icon = "rbxassetid://4483345998", PremiumOnly = false})

MainTab:AddToggle({
    Name = "Enable Role ESP",
    Default = false,
    Callback = function(Value)
        _G.ESPEnabled = Value
        if not Value then clearESP() end
    end    
})

MainTab:AddToggle({
    Name = "Mobile Auto-Aimbot",
    Default = false,
    Callback = function(Value)
        _G.AimbotEnabled = Value
    end    
})

MainTab:AddSlider({
    Name = "Aimbot FOV Size",
    Min = 30,
    Max = 350,
    Default = 120, Color = Color3.fromRGB(255,255,255),
Increment = 1,
ValueName = "pixels",
Callback = function(Value)
_G.AimbotFOV = Value
end
})
FunTab:AddToggle({
Name = "Self Chams (Highlight)",
Default = false,
Callback = function(Value)
_G.SelfChamsEnabled = Value
end
})
OrionLib:Init()
