
-- Blox Note Multi-Hack Script
-- Библиотека: Orion UI. EN ids, RU comments, без TODO

local OrionLib = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Window = OrionLib:MakeWindow({Name = "Blox Note Hub", HidePremium = false, SaveConfig = true, ConfigFolder = "BloxNoteConfig"})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Глобальные переменные настроек софта
_G.ESPEnabled = false
_G.AimbotEnabled = false
_G.AimbotFOV = 150
_G.TracersEnabled = false
_G.SelfChamsEnabled = false

-- FOV Круг для Аимбота
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.8

-- Функция очистки меток
local function clearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local oldESP = p.Character.Head:FindFirstChild("RoleESP")
            if oldESP then oldESP:Destroy() end
        end
    end
end

-- Функция создания ESP
local function createESP(player, text, color)
    if not _G.ESPEnabled or player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    
    local head = character:WaitForChild("Head", 2)
    local root = character:WaitForChild("HumanoidRootPart", 2)
    if not head or not root then return end
    
    local billboard = head:FindFirstChild("RoleESP")
    local label
    
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "RoleESP"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 250, 0, 70)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.Parent = head

        label = Instance.new("TextLabel")
        label.Name = "ESPLabel"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextSize = 16
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0
        label.Parent = billboard
    else
        label = billboard:FindFirstChild("ESPLabel")
    end

    if label and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
        label.Text = string.format("%s\n%s\n[%d m]", text, player.Name, distance)
        label.TextColor3 = color
    end
end

-- Логика определения роли игрока
local function getPlayerRole(p)
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    
    -- Проверка оружия/предметов в руках (раскрытые роли)
    local hasKiraItem = (backpack and backpack:FindFirstChild("Death Note")) or (char and char:FindFirstChild("Death Note"))
    local hasAssistantItem = (backpack and (backpack:FindFirstChild("Second Death Note") or backpack:FindFirstChild("Death Note 2"))) or (char and (char:FindFirstChild("Second Death Note") or char:FindFirstChild("Death Note 2")))
    
    if hasKiraItem then return "KIRA" end
    if hasAssistantItem then return "ASSISTANT" end
    
    if p:FindFirstChild("IsL") or p:GetAttribute("Role") == "L" or (backpack and backpack:FindFirstChild("L Notebook")) then
        return "L"
    end
    return "INVESTIGATOR"
end

-- Функция Аимбота (только по раскрытым Кире и Помощнику)
local function getClosestKiraToCursor()
    local closestPlayer = nil
    local shortestDistance = _G.AimbotFOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then

local role = getPlayerRole(p)
            
            -- Аимбот жестко триггерится только на Киру или Помощника, доставших блокнот
            if role == "KIRA" or role == "ASSISTANT" then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    
                    if distance < shortestDistance then
                        closestPlayer = p
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Управление Чамсами на себя
local function updateSelfChams()
    local char = LocalPlayer.Character
    if not char then return end
    
    local chams = char:FindFirstChild("SelfChams")
    if _G.SelfChamsEnabled then
        if not chams then
            chams = Instance.new("Highlight")
            chams.Name = "SelfChams"
            chams.FillColor = Color3.fromRGB(0, 255, 255)
            chams.FillTransparency = 0.5
            chams.OutlineColor = Color3.fromRGB(255, 255, 255)
            chams.OutlineTransparency = 0
            chams.Parent = char
        end
    else
        if chams then chams:Destroy() end
    end
end

-- Хранилище линий для Трейсеров
local LinesCache = {}

local function clearTracers()
    for _, line in pairs(LinesCache) do
        line.Visible = false
        line:Remove()
    end
    table.clear(LinesCache)
end

local function updateTracers()
    if not _G.TracersEnabled then
        clearTracers()
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local line = LinesCache[p]
            if not line then
                line = Drawing.new("Line")
                line.Thickness = 1.5
                line.Transparency = 0.7
                LinesCache[p] = line
            end

            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local role = getPlayerRole(p)
                if role == "KIRA" or role == "ASSISTANT" then
                    line.Color = Color3.fromRGB(255, 0, 0)
                elseif role == "L" then
                    line.Color = Color3.fromRGB(0, 100, 255)
                else
                    line.Color = Color3.fromRGB(0, 255, 0)
                end

                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            if LinesCache[p] then
                LinesCache[p].Visible = false
            end
        end
    end
end

-- Главный цикл обновлений
RunService.RenderStepped:Connect(function()
    -- Обновление круга FOV
    if _G.AimbotEnabled then
        FOVCircle.Position = UserInputService:GetMouseLocation()
        FOVCircle.Radius = _G.AimbotFOV
        FOVCircle.Visible = true
        
        -- Логика наведения аимбота на HumanoidRootPart (Тело)
        local target = getClosestKiraToCursor()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then -- Удержание ПКМ для доводки
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
            end
        end
    else
        FOVCircle.Visible = false
    end

    -- Обновление Трейсеров
    updateTracers()
    
    -- Обновление Чамсов на себя
    updateSelfChams()
end)

-- Цикл проверки ролей и дистанции ESP
task.spawn(function()
    while true do
        if _G.ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getPlayerRole(p)
                    if role == "KIRA" then
                        createESP(p, "[ KIRA ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "ASSISTANT" then
                        createESP(p, "[ KIRA ASSISTANT ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "L" then
                        createESP(p, "[ L ]", Color3.fromRGB(0, 100, 255))
                    else
                        createESP(p, "[ INVESTIGATOR ]", Color3.fromRGB(0, 255, 0))
                    end
                end
            end
        else
            clearESP()
        end
        task.wait(0.1)
    end
end)

-- Создание вкладок в интерфейсе Orion
local MainTab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local FunTab = Window:MakeTab({
    Name = "Fun",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Наполнение вкладки Main
MainTab:AddToggle({
    Name = "Enable Role ESP",
    Default = false,
    Callback = function(Value)
        _G.ESPEnabled = Value
        if not Value then clearESP() end
    end    
})

MainTab:AddToggle({
    Name = "Enable Anti-Kira Aimbot (Hold RMB)",
    Default = false,
    Callback = function(Value)
        _G.AimbotEnabled = Value
    end    
})

MainTab:AddSlider({
    Name = "Aimbot FOV Size",
    Min = 50,
    Max = 500,
    Default = 150,
    Color = Color3.fromRGB(255,255,255),
    Increment = 1,
    ValueName = "pixels",
    Callback = function(Value)
        _G.AimbotFOV = Value
    end    
})

-- Наполнение вкладки Fun
FunTab:AddToggle({
    Name = "Enable Tracer Lines",
    Default = false,
    Callback = function(Value)
        _G.TracersEnabled = Value
        if not Value then clearTracers() end
    end    
})

FunTab:AddToggle({
    Name = "Self Chams (Highlight)",
    Default = false,

Callback = function(Value)
_G.SelfChamsEnabled = Value
end
})
OrionLib:Init()
