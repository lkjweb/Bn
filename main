
-- Blox Note Hub (Rayfield UI Mobile Premium Build v5.5 - Absolute Final Build)
-- EN ids, RU comments, без TODO

-- Официальный импорт мобильного Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu'))()

local Window = Rayfield:CreateWindow({
   Name = "Blox Note Hub",
   LoadingTitle = "Loading Script Suite...",
   LoadingSubtitle = "by TWKS",
   Theme = "Default",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

-- Глобальные настройки софта
_G.ESPEnabled = false
_G.AimbotEnabled = false
_G.AimbotFOV = 250
_G.SelfChamsEnabled = false

-- Тотальное удаление остатков старых кастомных UI перед запуском
if CoreGui:FindFirstChild("BloxNoteHubGui") then CoreGui.BloxNoteHubGui:Destroy() end
if CoreGui:FindFirstChild("OrionToggleGui") then CoreGui.OrionToggleGui:Destroy() end

-- Улучшенный алгоритм детекции ролей для Blox Note
local function getPlayerRole(p)
    if not p then return "INVESTIGATOR" end
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    local playerGui = p:FindFirstChild("PlayerGui")
    
    local isKira = false
    local isAssistant = false
    
    local function checkItem(item)
        if not item or not item.Name then return end
        local name = string.lower(item.Name)
        if string.find(name, "death") or string.find(name, "note") or string.find(name, "kira") then
            if string.find(name, "second") or string.find(name, "assistant") or string.find(name, "2") then
                isAssistant = true
            else
                isKira = true
            end
        end
    end

    if backpack then 
        for _, item in ipairs(backpack:GetChildren()) do checkItem(item) end 
    end
    if char then 
        for _, item in ipairs(char:GetChildren()) do 
            if item:IsA("Tool") then checkItem(item) end 
        end 
    end
    
    -- Сканирование локальных GUI элементов на предмет утечки ролей в текст
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("StringValue") then
                local txt = string.lower(gui.Text or gui.Value or "")
                if string.find(txt, "kira") or string.find(txt, "кира") then isKira = true end
                if string.find(txt, "assistant") or string.find(txt, "помощник") then isAssistant = true end
            end
        end
    end

    if isAssistant then return "ASSISTANT" end
    if isKira or p:GetAttribute("Role") == "Kira" or p:GetAttribute("Kira") == true then return "KIRA" end
    if p:FindFirstChild("IsL") or p:GetAttribute("Role") == "L" or (backpack and backpack:FindFirstChild("L Notebook")) then return "L" end
    
    return "INVESTIGATOR"
end

-- Функция полной очистки ESP
local function clearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local old = p.Character.Head:FindFirstChild("RoleESP")
            if old then old:Destroy() end
        end
    end
end

-- Функция отрисовки текста ESP
local function createESPFrame(player, text, color)
    if not _G.ESPEnabled or player == LocalPlayer then return end
    local char = player.Character if not char then return end
    local head = char:WaitForChild("Head", 2)
    local root = char:WaitForChild("HumanoidRootPart", 2) if not head or not root then return end
    
    local bb = head:FindFirstChild("RoleESP")
    local lbl
    if not bb then
        bb = Instance.new("BillboardGui", head)

bb.Name = "RoleESP"
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        lbl = Instance.new("TextLabel", bb)
        lbl.Name = "ESPLabel"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextSize = 14
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextStrokeTransparency = 0
    else
        lbl = bb:FindFirstChild("ESPLabel")
    end
    
    if lbl and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
        lbl.Text = string.format("%s\n%s\n[%d m]", text, player.Name, dist)
        lbl.TextColor3 = color
    end
end

-- Бесконечный рендер-цикл для Мобильного Аимбота и Чамсов
RunService.RenderStepped:Connect(function()
    if _G.AimbotEnabled and Camera.ViewportSize.X > 0 and Camera.ViewportSize.Y > 0 then
        local closestPlayer = nil
        local shortestDistance = _G.AimbotFOV
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local role = getPlayerRole(p)
                if role == "KIRA" or role == "ASSISTANT" then
                    local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if distance < shortestDistance then 
                            closestPlayer = p 
                            shortestDistance = distance 
                        end
                    end
                end
            end
        end
        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.HumanoidRootPart.Position)
        end
    end
    
    -- Логика Чамсов
    local char = LocalPlayer.Character
    if char then
        local chams = char:FindFirstChild("SelfChams")
        if _G.SelfChamsEnabled then
            if not chams then
                chams = Instance.new("Highlight", char)
                chams.Name = "SelfChams"
                chams.FillColor = Color3.fromRGB(0, 255, 255)
                chams.FillTransparency = 0.5
                chams.OutlineColor = Color3.fromRGB(255, 255, 255)
                chams.OutlineTransparency = 0
            end
        else
            if chams then chams:Destroy() end
        end
    end
end)

-- Потоковый цикл обновлений ESP
task.spawn(function()
    while true do
        if _G.ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getPlayerRole(p)
                    if role == "KIRA" then 
                        createESPFrame(p, "[ KIRA ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "ASSISTANT" then 
                        createESPFrame(p, "[ KIRA ASSISTANT ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "L" then 
                        createESPFrame(p, "[ L ]", Color3.fromRGB(0, 100, 255))
                    else 
                        createESPFrame(p, "[ INVESTIGATOR ]", Color3.fromRGB(0, 255, 0)) 
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- Создание структуры меню в Rayfield UI через официальные методы
local MainTab = Window:CreateTab("Main Settings", nil)
local FunTab = Window:CreateTab("Fun & Visuals", nil)

-- Наполнение вкладки Main
MainTab:CreateToggle({
   Name = "Enable Role ESP (Names & Meters)",
   CurrentValue = false,
   Callback = function(Value)
      _G.ESPEnabled = Value
      if not Value then clearESP() end
   end,
})

MainTab:CreateToggle({
   Name = "Mobile Auto-Aimbot (Anti-Kira)",
   CurrentValue = false,
   Callback = function(Value)
      _G.AimbotEnabled = Value
   end,
})

MainTab:CreateSlider({
   Name = "Aimbot FOV Size",
   Min = 50,
   Max = 400,
   CurrentValue = 250,
   Callback = function(Value)
      _G.AimbotFOV = Value
   end,
})

-- Наполнение вкладки Fun
FunTab:CreateToggle({
   Name = "Self Chams (Highlight Body)",
   CurrentValue = false,
   Callback = function(Value)
      _G.SelfChamsEnabled = Value
   end,
})
