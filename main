
-- Blox Note Multi-Hack (Custom Mobile Build v2.0 - Verified & Fixed)
-- EN ids, RU comments, без TODO

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

-- Настройки софта (Исправлена инициализация)
_G.ESPEnabled = false
_G.AimbotEnabled = false
_G.AimbotFOV = 200
_G.SelfChamsEnabled = false

-- Тотальная очистка старых элементов перед запуском
if CoreGui:FindFirstChild("BloxNoteHubGui") then CoreGui.BloxNoteHubGui:Destroy() end
if CoreGui:FindFirstChild("OrionToggleGui") then CoreGui.OrionToggleGui:Destroy() end

-- Создание кастомного UI
local mainGui = Instance.new("ScreenGui", CoreGui)
mainGui.Name = "BloxNoteHubGui"
mainGui.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", mainGui)
mainFrame.Size = UDim2.new(0, 320, 0, 240)
mainFrame.Position = UDim2.new(0.5, -160, 0.5, -120)
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Visible = true

local corner = Instance.new("UICorner", mainFrame)
corner.CornerRadius = UDim.new(0, 10)

local stroke = Instance.new("UIStroke", mainFrame)
stroke.Color = Color3.fromRGB(255, 0, 0)
stroke.Thickness = 2

local title = Instance.new("TextLabel", mainFrame)
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "BLOX NOTE HUB"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
title.TextSize = 16
title.Font = Enum.Font.SourceSansBold

local titleCorner = Instance.new("UICorner", title)
titleCorner.CornerRadius = UDim.new(0, 10)

-- Конструктор кнопок
local function createToggle(name, yPos, callback)
    local btn = Instance.new("TextButton", mainFrame)
    btn.Size = UDim2.new(0, 280, 0, 35)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 0, 0)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold
    
    local bCorner = Instance.new("UICorner", btn)
    bCorner.CornerRadius = UDim.new(0, 6)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = name .. ": ON"
            btn.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            btn.Text = name .. ": OFF"
            btn.TextColor3 = Color3.fromRGB(255, 0, 0)
        end
        callback(state)
    end)
end

-- Активация функций в UI
createToggle("Role ESP", 55, function(v) 
    _G.ESPEnabled = v 
    if not v then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") then
                local old = p.Character.Head:FindFirstChild("RoleESP")
                if old then old:Destroy() end
            end
        end
    end
end)

createToggle("Mobile Aimbot", 100, function(v) _G.AimbotEnabled = v end)
createToggle("Self Chams", 145, function(v) _G.SelfChamsEnabled = v end)

-- Создание плавающей кнопки MENU
local toggleGui = Instance.new("ScreenGui", CoreGui)
toggleGui.Name = "OrionToggleGui"
toggleGui.ResetOnSpawn = false

local menuBtn = Instance.new("TextButton", toggleGui)
menuBtn.Size = UDim2.new(0, 60, 0, 60)
menuBtn.Position = UDim2.new(0, 10, 0, 150)
menuBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
menuBtn.Text = "MENU"
menuBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
menuBtn.TextSize = 14
menuBtn.Font = Enum.Font.SourceSansBold

local mCorner = Instance.new("UICorner", menuBtn)
mCorner.CornerRadius = UDim.new(0, 30)

local mStroke = Instance.new("UIStroke", menuBtn)
mStroke.Color = Color3.fromRGB(255, 0, 0)
mStroke.Thickness = 2

menuBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
end)

-- Алгоритм сканирования инвентаря на роли
local function getPlayerRole(p)
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    local isKira = false
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if string.find(string.lower(item.Name), "death") or string.find(string.lower(item.Name), "note") or string.find(string.lower(item.Name), "kira") then
                if not string.find(string.lower(item.Name), "second") and not string.find(string.lower(item.Name), "2") and not string.find(string.lower(item.Name), "l") then isKira = true end
            end
        end
    end
    if isKira or p:GetAttribute("Role") == "Kira" then return "KIRA" end
    if p:FindFirstChild("IsL") or p:GetAttribute("Role") == "L" then return "L" end
    return "INVESTIGATOR"
end

-- Отрисовка текста ESP
local function createESPFrame(player, text, color)
    if not _G.ESPEnabled or player == LocalPlayer then return end
    local char = player.Character if not char then return end
    local head = char:WaitForChild("Head", 2)
    local root = char:WaitForChild("HumanoidRootPart", 2) if not head or not root then return end
    
    local bb = head:FindFirstChild("RoleESP")
    local lbl
    if not bb then
        bb = Instance.new("BillboardGui", head)
        bb.Name = "RoleESP"
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        lbl = Instance.new("TextLabel", bb)
        lbl.Name = "ESPLabel"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextSize = 14
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextStrokeTransparency = 0
    else
        lbl = bb:FindFirstChild("ESPLabel")
    end
    
    if lbl and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
        lbl.Text = string.format("%s\n%s\n[%d m]", text, player.Name, dist)
        lbl.TextColor3 = color
    end
end

-- Бесконечный цикл проверки кадров (Аимбот и Чамсы)
RunService.RenderStepped:Connect(function()
    if _G.AimbotEnabled then
        local closestPlayer = nil
        local shortestDistance = _G.AimbotFOV
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if getPlayerRole(p) == "KIRA" then
                    local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if distance < shortestDistance then 
                            closestPlayer = p 
                            shortestDistance = distance 
                        end
                    end
                end
            end
        end
        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.HumanoidRootPart.Position)
        end
    end
    
    -- Логика Чамсов
    local char = LocalPlayer.Character
    if char then
        local chams = char:FindFirstChild("SelfChams")
        if _G.SelfChamsEnabled then
            if not chams then
                chams = Instance.new("Highlight", char)
                chams.Name = "SelfChams"
                chams.FillColor = Color3.fromRGB(0, 255, 255)
                chams.FillTransparency = 0.5
                chams.OutlineColor = Color3.fromRGB(255, 255, 255)
                chams.OutlineTransparency = 0
            end
        else
            if chams then chams:Destroy() end
        end
    end
end)

-- Цикл обновлений ESP
task.spawn(function()
    while true do
        if _G.ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getPlayerRole(p)
                    if role == "KIRA" then createESPFrame(p, "[ KIRA ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "L" then createESPFrame(p, "[ L ]", Color3.fromRGB(0, 100, 255))
                    else createESPFrame(p, "[ INVESTIGATOR ]", Color3.fromRGB(0, 255, 0)) end
                end
            end
        end
        task.wait(0.2)
    end
end)
