-- Blox Note Hub (Fluent UI Mobile Premium Build v3.5 - Verified Fixed)
-- EN ids, RU comments, без TODO

local Fluent = loadstring(game:HttpGet("https://github.com"))()

local Window = Fluent:CreateWindow({
    Title = "Blox Note Hub",
    SubTitle = "by TWKS",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true, -- Красивое полупрозрачное размытие заднего фона
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

-- Глобальные настройки софта
_G.ESPEnabled = false
_G.AimbotEnabled = false
_G.AimbotFOV = 250
_G.SelfChamsEnabled = false

-- Тотальная очистка старых интерфейсов перед запуском
if CoreGui:FindFirstChild("BloxNoteHubGui") then CoreGui.BloxNoteHubGui:Destroy() end
if CoreGui:FindFirstChild("OrionToggleGui") then CoreGui.OrionToggleGui:Destroy() end

-- Создание красивой мобильной кнопки сворачивания/разворачивания интерфейса Fluent
local function createMobileToggle()
    local screenGui = Instance.new("ScreenGui", CoreGui)
    screenGui.Name = "OrionToggleGui"
    screenGui.ResetOnSpawn = false

    local button = Instance.new("TextButton", screenGui)
    button.Size = UDim2.new(0, 50, 0, 50)
    button.Position = UDim2.new(0, 20, 0, 180)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    button.Text = "★"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 20
    button.Font = Enum.Font.SourceSansBold
    button.BorderSizePixel = 0

    local uiCorner = Instance.new("UICorner", button)
    uiCorner.CornerRadius = UDim.new(0, 25)

    -- Скрипт перетаскивания (Drag) кнопки пальцем по экрану
    local dragging, dragInput, dragStart, startPos
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Привязка сворачивания Fluent UI к нашей кнопке
    button.MouseButton1Click:Connect(function()
        local fluentGui = CoreGui:FindFirstChild("Fluent")
        if fluentGui then
            for _, frame in ipairs(fluentGui:GetChildren()) do
                if frame:IsA("Frame") or frame:IsA("ScreenGui") then
                    frame.Enabled = not frame.Enabled
                elseif frame:IsA("GuiObject") then
                    frame.Visible = not frame.Visible
                end
            end
        end
    end)
end

createMobileToggle()

-- Глубокое сканирование ролей
local function getPlayerRole(p)
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            local name = string.lower(item.Name or "")
            if string.find(name, "death") or string.find(name, "note") or string.find(name, "kira") then

if string.find(name, "second") or string.find(name, "assistant") or string.find(name, "2") then
                    return "ASSISTANT"
                elseif not string.find(name, "l") then
                    return "KIRA"
                end
            end
        end
    end
    
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name or "")
                if string.find(name, "death") or string.find(name, "note") or string.find(name, "kira") then
                    if string.find(name, "second") or string.find(name, "assistant") or string.find(name, "2") then
                        return "ASSISTANT"
                    elseif not string.find(name, "l") then
                        return "KIRA"
                    end
                end
            end
        end
    end
    
    if p:FindFirstChild("IsL") or (backpack and backpack:FindFirstChild("L Notebook")) then return "L" end
    
    local attrRole = p:GetAttribute("Role") or p:GetAttribute("role") or ""
    attrRole = string.lower(tostring(attrRole))
    if string.find(attrRole, "kira") then return "KIRA" end
    if string.find(attrRole, "assistant") or string.find(attrRole, "second") then return "ASSISTANT" end
    if string.find(attrRole, "l") and #attrRole == 1 then return "L" end
    
    return "INVESTIGATOR"
end

-- Функция очистки ESP
local function clearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") then
            local old = p.Character.Head:FindFirstChild("RoleESP")
            if old then old:Destroy() end
        end
    end
end

-- Отрисовка текста ESP над головами
local function createESPFrame(player, text, color)
    if not _G.ESPEnabled or player == LocalPlayer then return end
    local char = player.Character if not char then return end
    local head = char:WaitForChild("Head", 2)
    local root = char:WaitForChild("HumanoidRootPart", 2) if not head or not root then return end
    
    local bb = head:FindFirstChild("RoleESP")
    local lbl
    if not bb then
        bb = Instance.new("BillboardGui", head)
        bb.Name = "RoleESP"
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        lbl = Instance.new("TextLabel", bb)
        lbl.Name = "ESPLabel"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextSize = 14
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextStrokeTransparency = 0
    else
        lbl = bb:FindFirstChild("ESPLabel")
    end
    
    if lbl and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
        lbl.Text = string.format("%s\n%s\n[%d m]", text, player.Name, dist)
        lbl.TextColor3 = color
    end
end

-- Рендер-цикл для Аимбота и Чамсов
RunService.RenderStepped:Connect(function()
    if _G.AimbotEnabled and Camera.ViewportSize.X > 0 and Camera.ViewportSize.Y > 0 then
        local closestPlayer = nil
        local shortestDistance = _G.AimbotFOV
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local role = getPlayerRole(p)
                if role == "KIRA" or role == "ASSISTANT" then
                    local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude

if distance < shortestDistance then 
                            closestPlayer = p 
                            shortestDistance = distance 
                        end
                    end
                end
            end
        end
        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.HumanoidRootPart.Position)
        end
    end
    
    -- Логика Чамсов
    local char = LocalPlayer.Character
    if char then
        local chams = char:FindFirstChild("SelfChams")
        if _G.SelfChamsEnabled then
            if not chams then
                chams = Instance.new("Highlight", char)
                chams.Name = "SelfChams"
                chams.FillColor = Color3.fromRGB(0, 255, 255)
                chams.FillTransparency = 0.5
                chams.OutlineColor = Color3.fromRGB(255, 255, 255)
                chams.OutlineTransparency = 0
            end
        else
            if chams then chams:Destroy() end
        end
    end
end)

-- Потоковый цикл обновлений ESP
task.spawn(function()
    while true do
        if _G.ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getPlayerRole(p)
                    if role == "KIRA" then createESPFrame(p, "[ KIRA ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "ASSISTANT" then createESPFrame(p, "[ KIRA ASSISTANT ]", Color3.fromRGB(255, 0, 0))
                    elseif role == "L" then createESPFrame(p, "[ L ]", Color3.fromRGB(0, 100, 255))
                    else createESPFrame(p, "[ INVESTIGATOR ]", Color3.fromRGB(0, 255, 0)) end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- Наполнение Fluent интерфейса вкладками и элементами
local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "box" }),
    Fun = Window:AddTab({ Title = "Fun", Icon = "smile" })
}

-- Элементы во вкладке Main
Tabs.Main:AddToggle("RoleESPToggle", {
    Title = "Enable Role ESP", Default = false,
Callback = function(Value)
_G.ESPEnabled = Value
if not Value then clearESP() end
end
})
Tabs.Main:AddToggle("AimbotToggle", {
Title = "Mobile Auto-Aimbot (Anti-Kira)",
Default = false,
Callback = function(Value)
_G.AimbotEnabled = Value
end
})
Tabs.Main:AddSlider("AimbotFOVSlider", {
Title = "Aimbot FOV Size",
Description = "Радиус захвата целей аимботом",
Min = 50,
Max = 400,
Default = 250,
Increment = 5,
Callback = function(Value)
_G.AimbotFOV = Value
end
})
-- Элементы во вкладке Fun
Tabs.Fun:AddToggle("ChamsToggle", {
Title = "Self Chams (Highlight)",
Default = false,
Callback = function(Value)
_G.SelfChamsEnabled = Value
end
})
-- Выбор первой вкладки при старте софта
Window:SelectTab(1)
